# qwakk-game-server environment. Placeholders only: real values live in
# CapRover (App Configs > Environmental Variables), never in the repo.

# Read by the server today
PORT=2567
QWAKK_SEED=1337
QWAKK_MAX_CLIENTS=8
QWAKK_BOTS=1
QWAKK_STATS=0
QWAKK_STATS_MS=5000
# Keep V8's heap under the CapRover memory limit (MiB). Leave room for Rapier's WASM memory.
NODE_OPTIONS=--max-old-space-size=768

# Leaderboard and identity (apps/server/src/meta)
# Postgres for the leaderboard (written only by the server). Use a dedicated role and database.
DATABASE_URL=postgres://qwakk_game:CHANGE_ME@srv-captain--CHANGE_ME:5432/qwakk_game
# At least 32 random characters. Required in production; rotating it resets every guest identity.
SESSION_SECRET=CHANGE_ME_TO_32_PLUS_RANDOM_CHARACTERS
# 1 behind CapRover's nginx, so per-IP limits read X-Forwarded-For.
TRUST_PROXY=1
# Comma separated origins allowed for /api, matchmaking and WebSocket upgrades.
ALLOWED_ORIGINS=https://qwakk.fun
# Cloudflare Turnstile secret for new guests. Unset skips verification (dev only).
TURNSTILE_SECRET=CHANGE_ME

# Never set these in production (test and dev switches)
# QWAKK_INTEREST=0
# QWAKK_SPECTATORS=1
# COLYSEUS_LATENCY=0
