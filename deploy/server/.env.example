# qwakk-game (CapRover app at play.qwakk.fun) environment. Placeholders only:
# real values live in CapRover (App Configs > Environmental Variables), never
# in the repo, an image or a log. Source of truth: apps/server/src/index.ts and
# apps/server/src/meta/config.ts. Runbook: docs/deploy.md.

# ---- Runtime (read by the server) ------------------------------------------

# Container port. Must match CapRover "Container HTTP Port".
PORT=2567
# At least 32 random characters (openssl rand -hex 32). Required: the image runs
# with NODE_ENV=production and refuses to start without it. Rotating it resets
# every guest identity.
SESSION_SECRET=CHANGE_ME_TO_32_PLUS_RANDOM_CHARACTERS
# 1 behind CapRover's nginx, so the per-IP limits read the client address from
# X-Forwarded-For. Use 2 only if a second proxy (Cloudflare orange cloud) sits in front.
TRUST_PROXY=1
# Browser origins allowed for /api, matchmaking and WebSocket upgrades. The page
# is served from the same origin, so this is that origin. Add https://qwakk.fun
# only for the optional split hosting (client at qwakk.fun/game).
ALLOWED_ORIGINS=https://play.qwakk.fun
# The leaderboard database (its own CapRover PostgreSQL app, see docs/deploy.md).
# Unset: no leaderboard and matches are not recorded; play still works.
DATABASE_URL=postgres://qwakk_game:CHANGE_ME@srv-captain--qwakk-game-db:5432/qwakk_game
# Cloudflare Turnstile secret for new guests (widget hostname play.qwakk.fun).
# Set it together with VITE_TURNSTILE_SITEKEY below, or leave both unset.
TURNSTILE_SECRET=
# Keep V8's heap under the 1 GiB container limit (MiB); Rapier's WASM memory sits outside it.
NODE_OPTIONS=--max-old-space-size=768

# Optional runtime switches
# Battle royale rooms open at once (default BR.maxRooms, 1 at launch).
# QWAKK_BR_MAX_ROOMS=1
# Print per-room tick timing, CPU and RSS to the logs every QWAKK_STATS_MS.
# QWAKK_STATS=1
# QWAKK_STATS_MS=15000
# Set by the image, do not override: QWAKK_NAV_CACHE=/srv/navcache, QWAKK_CLIENT_DIR=/srv/public, NODE_ENV=production

# Never set these in production (test, benchmark and dev switches)
# QWAKK_MAX_CLIENTS   (humans per deathmatch room, default 32; a lower value caps every room)
# QWAKK_DM_ROOMS      (benchmark only: opens more catalog rooms than the menu lists)
# QWAKK_BOTS=0  QWAKK_INTEREST=0  QWAKK_SPECTATORS=1  QWAKK_DM_MAP  QWAKK_DM_SPAWN_RADIUS
# QWAKK_BR_COUNTDOWN  QWAKK_BR_MIN_HUMANS  QWAKK_BR_SEED  QWAKK_ZONE_SCALE  QWAKK_SEED  COLYSEUS_LATENCY

# ---- Build time (CapRover passes app env vars to the Docker build) ---------
# Baked into the client bundle; changing one needs a rebuild (Force Build).

# Public Turnstile site key. Set together with TURNSTILE_SECRET, or leave both unset.
VITE_TURNSTILE_SITEKEY=
# Leave unset: the client talks to the origin it was loaded from (wss://play.qwakk.fun).
# VITE_GAME_SERVER=
# VITE_API_BASE=
