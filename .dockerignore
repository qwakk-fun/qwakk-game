# Build context for deploy/server/Dockerfile and deploy/web/Dockerfile.
# Both images build from the repo root, so keep the context small.

.git
.gitignore
# Local agent worktrees and settings (can be gigabytes).
.claude
**/node_modules
**/dist
**/.vite
**/.navcache
**/dist-test
**/*.log
**/*.cpuprofile
**/.DS_Store
coverage
test-results
playwright-report

# Never send local secrets to the Docker daemon.
**/.env
**/.env.*
!**/.env.example

# Not needed by any image (tests, benchmarks, art sources and renders, docs).
art
e2e
docs
scripts
**/test
apps/server/bench
**/*.blend
**/*.blend1
**/__pycache__
docker-compose.yml
